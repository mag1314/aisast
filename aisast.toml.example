# AI-SAST configuration — copy to aisast.toml in the project you scan (all keys optional).

[ollama]
url = "http://localhost:11434"      # or set OLLAMA_HOST
model = "qwen2.5-coder:7b"          # triage / deep-scan / explanations (AISAST_MODEL)
fix_model = ""                      # optional larger model for remediation, e.g. "qwen2.5-coder:14b"
temperature = 0.1
num_ctx = 8192
timeout = 300                       # seconds per LLM call

[ai]
ai_enabled = true
triage = true                       # verify + explain every finding
deep_scan = false                   # LLM discovery pass (access control, IDOR, logic) — same as --deep
fp_threshold = 0.75                 # AI confidence needed to suppress a finding (critical needs >= 0.85)
max_ai_findings = 200
deep_scan_max_files = 60
cache = true                        # reuse identical LLM answers (.aisast/cache)

[scan]
exclude = ["migrations", "docs"]    # appended to built-in excludes (node_modules, venv, .git, ...)
max_file_kb = 512
strict = false                      # report every MD5/SHA-1/random use, not only security contexts
min_severity = "info"

[fix]
fix_attempts = 3                    # LLM generate -> validate -> feedback rounds per fix
fix_min_severity = "low"
test_command = ""                   # e.g. "python -m pytest -q" — must pass with patches applied
git_branch_prefix = "aisast/fix"

[report]
formats = ["html", "json", "sarif", "md"]
output_dir = ".aisast/reports"
